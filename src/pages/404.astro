---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noindex>
  <section class="bg-gray-50">
    <div class="container mx-auto px-4 py-24 text-center">
      <p class="text-orange-main font-semibold tracking-wide mb-2">Error 404</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">Halaman tidak ditemukan</h1>
      <p class="text-lg text-gray-600 max-w-xl mx-auto mb-8">
        Tautan yang Anda buka sudah dipindahkan atau tidak pernah ada.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="bg-orange-main text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-dark transition-colors">Kembali ke Beranda</a>
        <a href="/services" class="bg-white text-gray-800 border border-slate-300 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors">Lihat Layanan</a>
      </div>
    </div>
  </section>
</BaseLayout>
