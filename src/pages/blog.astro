---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedSlider from '../components/blog/FeaturedSlider';
import { articles, formatMeta } from '../data/articles';

const topStories = [...articles].sort((a, b) => b.views - a.views).slice(0, 6);
const featuredRaw = articles.filter((a) => a.featured);
const featuredList = (featuredRaw.length ? featuredRaw : topStories).slice(0, 5);

const categories = [
  'Training & Workshops',
  'Consultancy & Operations',
  'Coaching & Leadership',
] as const;
---

<BaseLayout
  title="Insights & Stories"
  description="Ide praktis dari ranah training, consultancy, dan coaching — ditulis untuk hasil nyata di lapangan."
>
  <section class="pt-16 pb-10 bg-gradient-to-r from-slate-900 to-slate-700 text-white">
    <div class="mx-auto" style="width: 90%">
      <h1 class="text-4xl md:text-5xl font-extrabold">Insights & Stories</h1>
      <p class="text-slate-200 mt-2">
        Practical ideas from training, consultancy, and coaching—built for real-world results.
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="mx-auto" style="width: 90%">
      <FeaturedSlider client:visible items={featuredList} />
    </div>
  </section>

  <section class="py-10 bg-orange-50">
    <div class="mx-auto" style="width: 90%">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-2xl font-bold">Top Stories</h2>
        <span class="text-slate-500 text-sm">Based on views</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          topStories.map((a) => (
            <article class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
              <img src={a.image} alt={a.title} width="600" height="400" loading="lazy" class="w-full h-40 object-cover rounded-lg mb-3" />
              <h3 class="font-semibold mb-1">{a.title}</h3>
              <p class="text-slate-600 text-sm mb-2">
                {a.description.slice(0, 100)}{a.description.length > 100 ? '…' : ''}
              </p>
              <span class="text-slate-500 text-xs">{formatMeta(a)}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    categories.map((cat, i) => (
      <section class={i % 2 === 0 ? 'py-10 bg-white' : 'py-10 bg-orange-50'}>
        <div class="mx-auto" style="width: 90%">
          <h2 class="text-2xl font-bold mb-6">{cat}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {articles
              .filter((a) => a.category === cat)
              .slice(0, 6)
              .map((a) => (
                <article class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
                  <img src={a.image} alt={a.title} width="600" height="400" loading="lazy" class="w-full h-40 object-cover rounded-lg mb-3" />
                  <h3 class="font-semibold mb-1">{a.title}</h3>
                  <p class="text-slate-600 text-sm mb-2">{a.description}</p>
                  <span class="text-slate-500 text-xs">{formatMeta(a)}</span>
                </article>
              ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="py-10 bg-white">
    <div class="mx-auto" style="width: 90%">
      <h2 class="text-2xl font-bold mb-6">All Stories</h2>
      <div class="space-y-4">
        {
          articles.map((a) => (
            <article class="bg-white border border-slate-200 rounded-xl shadow-sm p-4 flex items-start gap-4">
              <img src={a.image} alt={a.title} width="600" height="400" loading="lazy" class="w-28 h-28 object-cover rounded-lg flex-shrink-0" />
              <div class="min-w-0">
                <h3 class="font-semibold mb-1 truncate">{a.title}</h3>
                <p class="text-slate-600 text-sm mb-2 line-clamp-2">{a.description}</p>
                <span class="text-slate-500 text-xs">{formatMeta(a)}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12 bg-orange-50">
    <div class="mx-auto" style="width: 90%">
      <div class="rounded-xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6">
        <div class="flex-1">
          <h3 class="text-xl font-bold">Subscribe to our newsletter</h3>
          <p class="text-slate-600 text-sm">
            Get new stories on training, consultancy, and coaching—straight to your inbox.
          </p>
        </div>
        <form class="w-full md:w-auto flex gap-2">
          <label class="sr-only" for="newsletter-email">Email</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder="you@company.com"
            class="w-full md:w-80 px-4 py-2 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-orange-400"
          />
          <button type="submit" class="px-4 py-2 rounded-md bg-orange-main text-white shadow hover:shadow-md">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
