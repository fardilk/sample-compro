---
import { getImage } from 'astro:assets';

import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedSlider from '../components/blog/FeaturedSlider';
import { getArticles, mediaURL } from '../lib/cms';
import type { CmsArticle } from '../lib/cms';

const articles = await getArticles();

async function localise(path: string | undefined, width: number, height: number) {
  const src = mediaURL(path);
  if (!src) return undefined;
  try {
    const image = await getImage({ src, width, height, format: 'webp' });
    return image.src;
  } catch {
    return undefined;
  }
}

const covers: Record<string, string> = {};
for (const a of articles) {
  const local = await localise(a.featured_image, 600, 400);
  if (local) covers[a.slug] = local;
}

const dateFormat = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});

const metaFor = (a: CmsArticle) =>
  [
    a.published_at ? dateFormat.format(new Date(a.published_at)) : null,
    a.reading_time ? `${a.reading_time} menit baca` : null,
  ]
    .filter(Boolean)
    .join(' · ');

const featured = (articles.filter((a) => a.is_featured).length > 0
  ? articles.filter((a) => a.is_featured)
  : articles
)
  .slice(0, 5)
  .map((a) => ({
    slug: a.slug,
    title: a.title,
    excerpt: a.excerpt,
    meta: metaFor(a),
    image: covers[a.slug],
  }));

// Grouped by the categories that actually carry articles, so an empty category
// never renders an empty heading.
const byCategory = new Map<string, CmsArticle[]>();
for (const a of articles) {
  for (const c of a.categories ?? []) {
    const list = byCategory.get(c.name) ?? [];
    list.push(a);
    byCategory.set(c.name, list);
  }
}
import Icon from '../components/global/Icon';
---

<BaseLayout
  title="Insights & Stories"
  description="Ide praktis dari ranah training, consultancy, dan coaching — ditulis untuk hasil nyata di lapangan."
>
  <section class="bg-gradient-to-r from-slate-900 to-slate-700 pt-16 pb-10 text-white">
    <div class="mx-auto" style="width: 90%">
      <h1 class="text-4xl font-extrabold md:text-5xl">Insights &amp; Stories</h1>
      <p class="mt-2 text-slate-200">
        Ide praktis dari ranah training, consultancy, dan coaching—ditulis untuk hasil nyata.
      </p>
    </div>
  </section>

  {
    articles.length === 0 ? (
      <section class="bg-white py-20">
        <div class="mx-auto text-center" style="width: 90%">
          <Icon name="fa-feather-pointed" size={36} class:list={["mb-4 text-slate-300"]} />
          <h2 class="text-xl font-bold text-slate-900">Tulisan pertama sedang disiapkan</h2>
          <p class="mx-auto mt-2 max-w-md text-slate-600">
            Sementara itu, lihat program dan layanan kami, atau hubungi tim untuk bicara langsung.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href="/services" class="rounded-md bg-orange-main px-5 py-2.5 font-semibold text-white hover:bg-orange-dark">
              Lihat Layanan
            </a>
            <a href="/home/contact" class="rounded-md border border-slate-300 px-5 py-2.5 font-semibold text-slate-800 hover:bg-slate-50">
              Hubungi Kami
            </a>
          </div>
        </div>
      </section>
    ) : (
      <>
        <section class="bg-white py-10">
          <div class="mx-auto" style="width: 90%">
            <FeaturedSlider client:visible items={featured} />
          </div>
        </section>

        <section class="bg-orange-50 py-10">
          <div class="mx-auto" style="width: 90%">
            <h2 class="mb-6 text-2xl font-bold">Semua Tulisan</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {articles.map((a) => (
                <a
                  href={`/blog/${a.slug}`}
                  class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
                >
                  {covers[a.slug] ? (
                    <img
                      src={covers[a.slug]}
                      alt={a.alt_text || a.title}
                      width="600"
                      height="400"
                      loading="lazy"
                      class="h-40 w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-40 w-full items-center justify-center bg-slate-100 text-slate-300">
                      <Icon name="fa-newspaper" size={24} />
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="mb-1 font-semibold text-slate-900">{a.title}</h3>
                    <p class="mb-2 flex-1 text-sm text-slate-600">{a.excerpt}</p>
                    <span class="text-xs text-slate-500">{metaFor(a)}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>

        {
          [...byCategory.entries()].map(([name, list]) => (
            <section class="bg-white py-10">
              <div class="mx-auto" style="width: 90%">
                <h2 class="mb-6 text-2xl font-bold">{name}</h2>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  {list.slice(0, 6).map((a) => (
                    <a
                      href={`/blog/${a.slug}`}
                      class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md"
                    >
                      <h3 class="mb-1 font-semibold text-slate-900">{a.title}</h3>
                      <p class="mb-2 text-sm text-slate-600">{a.excerpt}</p>
                      <span class="text-xs text-slate-500">{metaFor(a)}</span>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          ))
        }
      </>
    )
  }
</BaseLayout>
