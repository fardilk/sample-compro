---
import { getImage } from 'astro:assets';

import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingService from '../../../components/services/TrainingService';
import ServiceDetail from '../../../components/services/ServiceDetail';
import CmsService from '../../../components/services/CmsService';
import { serviceRoutes } from '../../../data/serviceRoutes';
import { trainingPrograms } from '../../../data/trainingPrograms';
import { getServices, mediaURL, hasContent } from '../../../lib/cms';
import type { CmsService as CmsServiceType } from '../../../lib/cms';

export const prerender = false;

// Routes still come from the navigation tree, so a page the menu links to
// cannot disappear just because it has not been moved into the CMS yet. A CMS
// entry for the same path takes over; the rest keep their in-repo content. A
// CMS-only page exists only while it is published.
const { category, id } = Astro.params;
const found = (await getServices()).find((s) => s.category === category && s.slug === id) ?? null;
const route = serviceRoutes.find((r) => r.categorySlug === category && r.idSlug === id);
if (!route && !found) return Astro.rewrite('/404');
const props = route
  ? { ...route, cms: found }
  : {
      categorySlug: found!.category,
      categoryLabel: found!.category_label,
      idSlug: found!.slug,
      title: found!.title,
      description: found!.subtitle,
      cms: found,
    };

const { categorySlug, categoryLabel, idSlug, title, description } = props;
const cms = props.cms as CmsServiceType | null;

/**
 * Pull every CMS image into the build output. Left as API URLs, the published
 * pages would still depend on the backend being up for their images, which
 * defeats the point of building a static snapshot.
 */
async function localise(path: string, width: number, height: number) {
  const src = mediaURL(path);
  if (!src) return undefined;
  // Already served from public/; nothing to fetch or optimise.
  if (src.startsWith('/')) return src;
  try {
    const image = await getImage({ src, width, height, format: 'webp' });
    return image.src;
  } catch {
    // A missing or unreadable upload should not take the whole build down.
    return undefined;
  }
}

const heroImage = cms ? await localise(cms.hero_image, 800, 600) : undefined;
const ogImage = cms ? await localise(cms.og_image, 1200, 630) : undefined;

const cmsResolved: CmsServiceType | null = cms
  ? {
      ...cms,
      proofs: await Promise.all(
        cms.proofs.map(async (p) => ({ ...p, image: (await localise(p.image, 160, 160)) ?? '' })),
      ),
    }
  : null;

// Training programs still carry their authored in-repo content.
const program = categorySlug === 'training'
  ? trainingPrograms.find((p) => p.slug === idSlug)
  : undefined;

const pageTitle = cms?.meta_title || cms?.title || `${title} — ${categoryLabel}`;
const pageDescription =
  cms?.meta_description || cms?.subtitle || description;
const shareImage = ogImage ?? heroImage ?? program?.content.hero?.imageSrc ?? '/img/og-default.jpg';

// A CMS entry only takes over once it has something to show; an empty draft
// promoted by mistake should not blank a page that already had content.
const useCms = cmsResolved !== null && hasContent(cmsResolved);
---

<BaseLayout title={pageTitle} description={pageDescription} image={shareImage}>
  <nav aria-label="Breadcrumb" class="bg-slate-900 text-white pt-10 pb-4">
    <div class="mx-auto text-sm" style="width: 90%">
      <a href="/services" class="text-slate-300 hover:text-white underline">Services</a>
      <span class="mx-2 text-slate-500">/</span>
      <span class="text-slate-300">{categoryLabel}</span>
      <span class="mx-2 text-slate-500">/</span>
      <span class="text-white font-medium">{cms?.title ?? title}</span>
    </div>
  </nav>

  {
    useCms ? (
      // Every section is static, so a CMS-backed page ships no JavaScript.
      <CmsService service={cmsResolved!} heroImage={heroImage} />
    ) : program ? (
      /* Tabs and accordions inside the variant need state, so the block hydrates.
         ponytail: whole-subtree island; split per section only if the JS shows up in a budget. */
      <TrainingService client:visible title={program.title} subtitle={program.subtitle} overrideContent={program.content} />
    ) : (
      <ServiceDetail client:visible categoryLabel={categoryLabel} title={title} description={description} />
    )
  }
</BaseLayout>
