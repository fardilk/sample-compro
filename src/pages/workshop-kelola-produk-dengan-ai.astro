---
import BaseLayout from '../layouts/BaseLayout.astro';

// Seeded content from the flyer; move to the CMS when batches are managed there.
const workshop = {
  title: 'Kelola Produkmu Sendiri dengan AI',
  tagline: 'Dari Ide ke Produk Digital',
  subtitle: 'Workshop + Pendampingan 1 Bulan',
  startDate: '2026-11-09',
  dateLabel: '9 November 2026',
  dayLabel: 'Senin',
  venue: 'Offline di Hotel',
  venueNote: 'Workshop tatap muka',
  normalPrice: 3500000,
  promoPrice: 2250000,
  earlyBirdPrice: 1900000,
  whatsapp: '6281292934488',
  phone: '0812 9293 4488',
};

const benefits = [
  'PRD produk yang solid',
  'Wireframe & prototype interaktif',
  'Aplikasi web yang berfungsi',
  'Build dengan AI model terbaru',
  'Backend & database',
  'Dokumentasi & launch produk',
  'Pendampingan 1 bulan',
  'Gratis domain & hosting',
];

const instructor = {
  name: 'Fardil Khalidi',
  role: 'Product Builder',
  experience: 'Ombudsman RI • PLN • Komdigi • Citilink',
};

const faqs = [
  {
    q: 'Apakah saya perlu bisa coding?',
    a: 'Tidak. Anda yang membawa ide, AI membantu eksekusinya, dan instruktur mendampingi sampai produk berfungsi.',
  },
  {
    q: 'Apa yang saya dapatkan setelah workshop?',
    a: 'PRD, wireframe dan prototype interaktif, aplikasi web yang berfungsi, backend dan database, dokumentasi, serta domain dan hosting gratis.',
  },
  {
    q: 'Berapa lama pendampingannya?',
    a: 'Satu bulan penuh setelah workshop tatap muka, sampai produk Anda siap diluncurkan.',
  },
  {
    q: 'Bagaimana cara mendaftar?',
    a: 'Hubungi kami lewat WhatsApp. Harga Early Bird berlaku selama kuota promo masih tersedia.',
  },
];

const idr = (n: number) => `Rp ${n.toLocaleString('id-ID')}`;
const waHref = `https://wa.me/${workshop.whatsapp}?text=${encodeURIComponent(
  `Halo, saya ingin mendaftar workshop "${workshop.title}" (${workshop.dateLabel}).`,
)}`;

const description =
  'Workshop tatap muka + pendampingan 1 bulan: bangun produk digital sendiri dengan AI, dari PRD, prototype, aplikasi web, backend, sampai launch. Early Bird Rp 1.900.000.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: workshop.title,
    description,
    startDate: workshop.startDate,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: 'Hotel (lokasi diumumkan kepada peserta)',
      address: { '@type': 'PostalAddress', addressCountry: 'ID' },
    },
    image: new URL('/img/workshop/instruktur.png', Astro.site).href,
    organizer: { '@type': 'Organization', name: 'Excellence Plus Indonesia', url: Astro.site?.href },
    performer: { '@type': 'Person', name: instructor.name, jobTitle: instructor.role },
    offers: [
      { '@type': 'Offer', name: 'Early Bird', price: workshop.earlyBirdPrice, priceCurrency: 'IDR', availability: 'https://schema.org/InStock', url: waHref },
      { '@type': 'Offer', name: 'Harga Promo', price: workshop.promoPrice, priceCurrency: 'IDR', availability: 'https://schema.org/InStock', url: waHref },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title="Workshop Kelola Produkmu Sendiri dengan AI"
  description={description}
  image="/img/workshop/instruktur.png"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="bg-gradient-to-r from-[#0a3a6e] to-[#1572b8] text-white">
    <div class="mx-auto py-14 md:py-20" style="width: 90%; max-width: 64rem">
      <p class="text-lg font-bold uppercase tracking-wide text-[#cfe3f5]">Kelola produkmu</p>
      <h1 class="mt-1 text-4xl font-extrabold leading-tight md:text-6xl">Sendiri dengan AI</h1>
      <p class="mt-3 text-xl font-semibold text-[#f7941d] md:text-2xl">{workshop.tagline}</p>
    </div>
  </section>

  <section class="bg-[#fff1e4] py-12">
    <div class="mx-auto grid items-center gap-8 md:grid-cols-[1fr_auto]" style="width: 90%; max-width: 64rem">
      <div>
        <p class="inline-block bg-[#0d4a8a] px-5 py-3 text-lg font-extrabold uppercase text-white md:text-2xl">
          {workshop.subtitle}
        </p>
        <p class="mt-6 text-xl font-semibold text-[#12335f] md:text-2xl">
          Satu orang dengan AI yang tepat bisa melakukan apa yang dulu butuh tim 5–10 orang.
        </p>
        <p class="mt-4 text-xl font-extrabold text-[#f26b2a] md:text-2xl">
          Kamu yang punya ide, AI yang bantu eksekusi.
        </p>
      </div>
      <img
        src="/img/workshop/early-bird.svg"
        alt=""
        width="175"
        height="171"
        class="mx-auto hidden h-40 w-40 md:block"
      />
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto grid gap-10 md:grid-cols-[320px_1fr]" style="width: 90%; max-width: 64rem">
      <figure>
        <div class="rounded-3xl border-4 border-[#1572b8] bg-white p-2 shadow-[10px_10px_0_#f7941d]">
          <img
            src="/img/workshop/instruktur.png"
            alt={`${instructor.name}, ${instructor.role}`}
            width="640"
            height="640"
            class="aspect-[310/350] w-full rounded-2xl object-cover object-[30%_top]"
          />
        </div>
        <figcaption class="mt-8">
          <p class="inline-block bg-[#0d4a8a] px-4 py-2 text-2xl font-extrabold text-white">{instructor.name}</p>
          <p class="mt-2 font-bold text-[#12335f]">{instructor.role}</p>
          <p class="text-sm font-semibold text-[#5a6880]">{instructor.experience}</p>
        </figcaption>
      </figure>

      <div>
        <h2 class="inline-block bg-[#0d4a8a] px-4 py-2 text-lg font-extrabold uppercase tracking-wider text-white">
          Yang kamu dapatkan
        </h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            benefits.map((b) => (
              <li class="flex gap-2 font-semibold text-[#12335f]">
                <span class="font-extrabold text-[#39b54a]" aria-hidden="true">✓</span>
                {b}
              </li>
            ))
          }
        </ul>

        <dl class="mt-10 grid gap-6 sm:grid-cols-2">
          <div>
            <dt class="font-semibold text-[#5a6880]">{workshop.dayLabel}</dt>
            <dd class="text-xl font-extrabold text-[#12335f]">
              <time datetime={workshop.startDate}>{workshop.dateLabel}</time>
            </dd>
          </div>
          <div>
            <dt class="text-xl font-extrabold uppercase text-[#12335f]">{workshop.venue}</dt>
            <dd class="font-semibold text-[#5a6880]">{workshop.venueNote}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-[#e6f0fa] py-12">
    <div class="mx-auto grid items-center gap-8 md:grid-cols-2" style="width: 90%; max-width: 64rem">
      <div class="border-l-4 border-[#39b54a] pl-5">
        <p class="text-sm font-bold uppercase tracking-widest text-[#8e8e94]">Harga normal</p>
        <p class="text-2xl font-semibold text-[#8e8e94] line-through">{idr(workshop.normalPrice)}</p>
        <p class="mt-3 font-extrabold uppercase tracking-wider text-[#0d4a8a]">Harga promo</p>
        <p class="text-3xl font-extrabold text-[#12335f]">{idr(workshop.promoPrice)},-</p>
        <p class="font-semibold text-[#5a6880]">/Peserta</p>
        <div class="mt-4 rounded-2xl bg-[#f26b2a] px-4 py-3 text-white">
          <p class="font-extrabold uppercase tracking-wider">Early Bird</p>
          <p class="text-3xl font-extrabold">{idr(workshop.earlyBirdPrice)},-</p>
          <p class="text-[#ffe8d6]">/Peserta</p>
        </div>
      </div>

      <a
        href={waHref}
        class="flex items-center gap-4 rounded-full border-4 border-[#1572b8] bg-white p-4 transition-shadow hover:shadow-lg"
      >
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-[#39b54a] font-extrabold text-white">WA</span>
        <span>
          <span class="block font-semibold text-[#5a6880]">Contact Person</span>
          <span class="block text-2xl font-extrabold text-[#12335f]">{workshop.phone}</span>
        </span>
      </a>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto" style="width: 90%; max-width: 48rem">
      <h2 class="text-2xl font-extrabold text-[#12335f]">Pertanyaan yang sering diajukan</h2>
      <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
        {
          faqs.map((f) => (
            <details class="py-4">
              <summary class="cursor-pointer font-semibold text-[#12335f]">{f.q}</summary>
              <p class="mt-2 text-slate-600">{f.a}</p>
            </details>
          ))
        }
      </div>
      <a
        href={waHref}
        class="mt-8 inline-block rounded-md bg-orange-main px-6 py-3 font-semibold text-white hover:bg-orange-dark"
      >
        Daftar via WhatsApp
      </a>
    </div>
  </section>

  <div class="flex h-3" aria-hidden="true">
    <div class="w-1/2 bg-[#1572b8]"></div>
    <div class="w-1/4 bg-[#f7941d]"></div>
    <div class="w-1/4 bg-[#39b54a]"></div>
  </div>
</BaseLayout>
