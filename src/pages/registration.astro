---
import BaseLayout from '../layouts/BaseLayout.astro';
import RegistrationForm from '../components/ui/RegistrationForm';
import Icon from '../components/global/Icon';
import { getServices } from '../lib/cms';

const services = await getServices();
const programs = Object.fromEntries(services.map((s) => [s.slug, s.title]));

const dateRange = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});
const dayOnly = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  timeZone: 'Asia/Jakarta',
});

// Every open batch, soonest first — the same source the schedule page reads,
// so the two pages can never disagree about what is still available.
const batches = services
  .flatMap((service) =>
    service.schedules
      .filter((schedule) => schedule.starts_at)
      .map((schedule) => ({ service, schedule })),
  )
  .filter(({ schedule }) => new Date(schedule.starts_at!).getTime() > Date.now())
  .sort(
    (a, b) =>
      new Date(a.schedule.starts_at!).getTime() - new Date(b.schedule.starts_at!).getTime(),
  );

const spanOf = (startsAt: string, endsAt?: string | null) => {
  if (!endsAt || new Date(endsAt).toDateString() === new Date(startsAt).toDateString()) {
    return dateRange.format(new Date(startsAt));
  }
  return `${dayOnly.format(new Date(startsAt))} – ${dateRange.format(new Date(endsAt))}`;
};
---

<BaseLayout
  title="Pendaftaran Program"
  description="Formulir pendaftaran program training dan sertifikasi Excellence Plus Indonesia."
>
  <section class="bg-slate-900 text-white">
    <div class="mx-auto py-12 md:py-14" style="width: 90%">
      <p class="text-sm font-semibold uppercase tracking-wide text-orange-main">Pendaftaran</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight md:text-4xl">
        Formulir Pendaftaran Program
      </h1>
      <p class="mt-3 max-w-2xl text-slate-200">
        Isi data di bawah selengkap-lengkapnya. Nama dan alamat yang Anda tulis dipakai untuk
        mencetak dan mengirim sertifikat, jadi tulis persis seperti yang seharusnya tercetak.
      </p>
    </div>
  </section>

  <section class="bg-white py-12">
    <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[1.4fr_1fr]" style="width: 90%">
      <div class="rounded-xl border border-slate-200 p-6">
        <RegistrationForm client:load programs={programs} />
      </div>

      <aside class="space-y-4">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
          <h2 class="font-semibold">Batch yang masih terbuka</h2>
          {
            batches.length === 0 ? (
              <p class="mt-2 text-sm text-slate-600">
                Belum ada batch terjadwal. Kirim saja formulirnya, kami hubungi begitu jadwal
                berikutnya dibuka.
              </p>
            ) : (
              <ul class="mt-3 space-y-3 text-sm">
                {batches.map(({ service, schedule }) => (
                  <li>
                    <a
                      href={`/registration?program=${service.slug}`}
                      class="font-medium text-slate-900 hover:underline"
                    >
                      {service.title}
                    </a>
                    <div class="text-slate-600">
                      {spanOf(schedule.starts_at!, schedule.ends_at)}
                      {schedule.city ? ` · ${schedule.city}` : ''}
                    </div>
                    {schedule.seats_left > 0 && (
                      <div class="text-slate-500">Sisa {schedule.seats_left} kursi</div>
                    )}
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="rounded-xl border border-slate-200 p-5">
          <h2 class="font-semibold">Butuh bantuan?</h2>
          <p class="mt-2 text-sm text-slate-600">
            Mendaftarkan beberapa peserta sekaligus, atau perlu invoice atas nama perusahaan?
            Hubungi kami langsung.
          </p>
          <a
            href="https://wa.me/6281292934488"
            class="mt-3 inline-flex items-center gap-2 font-semibold text-orange-main hover:text-orange-dark"
          >
            <Icon name="fa-comments" size={18} color="currentColor" />
            0812 9293 4488
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
