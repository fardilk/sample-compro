---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutIntro from '../sections/AboutIntro';
import About from '../components/home/About';
import Stats from '../components/home/Stats';
import OurTeam from '../components/ui/OurTeam';
import OurHistory from '../components/ui/OurHistory';
import OurValues from '../components/ui/OurValues';
import { historyBlocks } from '../data/history';
---

<BaseLayout
  title="Who We Are"
  description="Profil, visi, misi, tim, dan perjalanan Excellence Plus Indonesia sejak 2017."
>
  <AboutIntro />

  {/* Moved off the homepage, which now leads with the programme catalogue.
      This is unique-selling-point material and reads better beside the company
      story than in front of someone looking for a class. */}
  <About />
  <Stats />
  {/* Both carry local state, so both hydrate; everything above ships no JS. */}
  <OurTeam client:visible />
  <OurHistory client:visible blocks={historyBlocks} imageSrc="/img/excellence-plus-1.png" id="history" />
  <OurValues id="values" />
</BaseLayout>
