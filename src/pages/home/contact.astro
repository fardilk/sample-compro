---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactInfo from '../../sections/ContactInfo';
import ContactForm from '../../components/ui/ContactForm';
import { getServices } from '../../lib/cms';

// slug -> title, so a `?program=` link can name the programme it came from.
const programs = Object.fromEntries((await getServices()).map((s) => [s.slug, s.title]));
---

<BaseLayout
  title="Contact"
  description="Hubungi Excellence Plus Indonesia untuk program training, consultancy, dan coaching."
>
  <section class="bg-gray-50">
    <div class="container mx-auto px-4 py-16">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-800 mb-4">Get In Touch</h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Ready to start your next project? Contact us today and let's discuss how we can help.
        </p>
      </div>
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-10">
        <ContactInfo heading="Contact Information" />
        <div class="bg-white rounded-lg shadow p-6">
          <ContactForm client:visible programs={programs} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
